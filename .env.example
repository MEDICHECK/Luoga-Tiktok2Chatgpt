# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# TikTok Business Organic API (v1.3)
# Get these from your TikTok for Developers app and account-holder OAuth flow.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_BUSINESS_ID=
TIKTOK_WEBHOOK_SECRET=

# Public HTTPS callback registered in TikTok Developer Portal
TIKTOK_REDIRECT_URI=https://YOUR_DOMAIN/api/tiktok/oauth/callback

# Set true only after testing the generated replies.
AUTO_REPLY=false
